{
  "name": "universal-body-clock",
  "version": "1.6.0",
  "type": "module",
  "description": "给 AI 装一副会走的身子：十二格、八维、欲望、情绪、距离，还读你正文里的动作，碰一处往外传一圈。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "index.js",
    "client.js",
    "config",
    "locale",
    "icon.svg",
    "docs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
